# --- Agent core (required) ---
#
# Option A -- Anthropic directly (spec section 10's default):
#   ANTHROPIC_API_KEY=sk-ant-...
#   TWIN_AGENT_MODEL=claude-opus-5
#   leave TWIN_AGENT_BASE_URL empty
#
# Option B -- everything on OpenRouter credits:
#   ANTHROPIC_API_KEY=sk-or-v1-...          (your OpenRouter key)
#   TWIN_AGENT_BASE_URL=https://openrouter.ai/api
#   TWIN_AGENT_MODEL=anthropic/claude-...   (exact slug from openrouter.ai/models)
#   OPENROUTER_API_KEY=sk-or-v1-...         (same key again, for aux calls)
#
# OpenRouter's Anthropic-compatible endpoint speaks the same Messages API and
# passes tool use through unchanged, so the agent loop is identical either way.
ANTHROPIC_API_KEY=

# Leave empty for Anthropic direct. Note: use this rather than ANTHROPIC_BASE_URL
# -- dotenv won't override a shell variable of that name if one already exists.
TWIN_AGENT_BASE_URL=

# Main conversational/tool-use loop. Must be a bare model id for Anthropic
# direct, or a provider-prefixed slug when going through OpenRouter.
TWIN_AGENT_MODEL=claude-opus-5

# --- Auxiliary model calls (optional but recommended) ---
# Cheap, high-volume classification and scoring: email triage, deadline
# extraction, Exa result ranking. Keeps the expensive model off bulk work.
OPENROUTER_API_KEY=
TWIN_AUX_MODEL=anthropic/claude-haiku-4.5

# --- Storage ---
# Postgres 16 running locally. Database is created by scripts/init_db.py.
TWIN_DATABASE_URL=postgresql://localhost:5432/digital_twin

# --- Semantic recall + voice (optional) ---
# One key covers both. Without it, memory recall degrades to keyword search
# and the `voice` command is unavailable.
OPENAI_API_KEY=
TWIN_EMBEDDING_MODEL=text-embedding-3-small

# Voice I/O models.
TWIN_STT_MODEL=whisper-1
TWIN_TTS_MODEL=gpt-4o-mini-tts
TWIN_TTS_VOICE=alloy

# --- Opportunity discovery (Phase 3) ---
EXA_API_KEY=
EVENTBRITE_API_KEY=

# --- Google OAuth (Tier 1: Gmail + Calendar) ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRETS_FILE=./google_client_secret.json

# --- Gmail push notifications (optional, spec section 6) ---
# Full resource names. Setting BOTH enables push: the Gmail watch is registered
# and renewed automatically, and the scheduler drains a Pub/Sub *pull*
# subscription each tick (no public endpoint needed). Leave empty to stay on
# the polling sweep.
#
# Setting these also adds the pubsub OAuth scope, which invalidates any stored
# Google token -- re-run `onboard` after changing them.
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_SUBSCRIPTION=
